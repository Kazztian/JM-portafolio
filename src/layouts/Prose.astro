<section
  class="px-4 py-8 sm:px-6 lg:px-0

  prose
  prose-base sm:prose-base md:prose-lg lg:prose-xl xl:prose-xl
  max-w-none

  dark:prose-invert

  /* 🔹 HEADINGS */
  prose-h1:font-title prose-h1:font-bold prose-h1:text-gray-900 dark:prose-h1:text-white
  prose-h2:font-title prose-h2:font-semibold prose-h2:text-gray-800 dark:prose-h2:text-gray-100
  prose-h3:font-title prose-h3:font-medium prose-h3:text-gray-700 dark:prose-h3:text-gray-200

  /* 🔹 TEXTO */
  prose-p:text-justify prose-p:leading-relaxed prose-p:text-gray-700 dark:prose-p:text-gray-300

  /* 🔹 LINKS */
  prose-a:text-blue-600 hover:prose-a:text-blue-800 dark:prose-a:text-blue-400 hover:dark:prose-a:text-blue-300
  prose-a:no-underline hover:prose-a:underline transition

  /* 🔹 LISTAS */
  prose-ul:list-disc prose-ul:pl-5
  prose-ol:list-decimal prose-ol:pl-5
  prose-li:mb-1 prose-li:text-gray-700 dark:prose-li:text-gray-300

  /* 🔹 BLOCKQUOTE */
  prose-blockquote:italic prose-blockquote:border-l-4 prose-blockquote:pl-4
  prose-blockquote:border-gray-400 prose-blockquote:text-gray-600
  dark:prose-blockquote:border-gray-600 dark:prose-blockquote:text-gray-300

  /* 🔹 CÓDIGO INLINE */
  prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
  prose-code:font-mono prose-code:text-gray-800
  dark:prose-code:bg-gray-800 dark:prose-code:text-gray-100

  /* 🔹 BLOQUES DE CÓDIGO */
  prose-pre:bg-gray-900 prose-pre:text-white prose-pre:rounded-xl prose-pre:p-4 prose-pre:overflow-x-auto

  /* 🔹 IMÁGENES */
  prose-img:rounded-xl prose-img:shadow-md prose-img:mx-auto

  /* 🔹 TEXTO DESTACADO */
  prose-strong:font-bold prose-strong:text-gray-900 dark:prose-strong:text-white
  prose-em:italic prose-em:text-gray-600 dark:prose-em:text-gray-300

  /* 🔹 DIVISORES */
  prose-hr:border-gray-300 dark:prose-hr:border-gray-600
"
>
  <slot />
</section>