---
interface Props {
  title: string;
  icon: any;
  description: string;
}

const { title, icon: Icon, description } = Astro.props;
---

<article 
class="group relative overflow-hidden rounded-3xl h-full
  border border-gray-200 dark:border-gray-700
  bg-white/80 dark:bg-gray-800/80
  backdrop-blur-sm
  p-8
  transition-all duration-300
  hover:-translate-y-2
  hover:shadow-2xl
  hover:shadow-primary-500/10
  hover:border-primary-400"
>
  <!-- Glow -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100
    transition-opacity duration-300
    bg-gradient-to-br from-primary-500/5 via-transparent to-primary-400/10"
  />

  <!-- Icon -->
  <div
    class="relative mb-6 flex items-center justify-center
    w-20 h-20 rounded-2xl
    bg-primary-500
    shadow-lg shadow-primary-500/30
    transition-all duration-300
    group-hover:scale-110
    group-hover:rotate-3"
  >
    <Icon
      className="text-white size-10"
    />
  </div>

  <!-- Title -->
  <h3
    class="relative text-xl lg:text-2xl font-bold mb-4
    text-gray-900 dark:text-white
    transition-colors duration-300
    group-hover:text-primary-500"
  >
    {title}
  </h3>

  <!-- Description -->
  <p
    class="relative text-sm md:text-base leading-relaxed
    text-gray-600 dark:text-gray-300"
  >
    {description}
  </p>
</article>

