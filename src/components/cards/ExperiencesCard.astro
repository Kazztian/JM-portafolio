---
import { Image } from "astro:assets";

interface Props {
  titulo: string;
  fechaDeTrabajo: string;
  rol: string;
  iconoEmpresa: ImageMetadata;
  funciones: string[];
}

const {
  titulo,
  fechaDeTrabajo,
  rol,
  iconoEmpresa,
  funciones
} = Astro.props;
---

<article
  class="group relative overflow-hidden
  rounded-3xl border border-gray-200 dark:border-gray-700
  bg-white/80 dark:bg-gray-800/80
  backdrop-blur-sm
  p-6 lg:p-8
  transition-all duration-300
  hover:-translate-y-2
  hover:shadow-2xl
  hover:shadow-primary-500/10
  hover:border-primary-400"
>
  <!-- Glow -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100
    transition-opacity duration-300
    bg-gradient-to-br from-primary-500/5 via-transparent to-primary-400/10"
  />

  <!-- Header -->
  <div class="relative flex flex-col sm:flex-row gap-5">
    
    <!-- Logo -->
    <div
      class="flex items-center justify-center
      min-w-[90px] h-[90px]
      rounded-2xl
      bg-gray-100 dark:bg-gray-700
      border border-gray-200 dark:border-gray-600
      shadow-md"
    >
      <Image
        src={iconoEmpresa}
        alt={titulo}
        class="w-16 h-16 object-contain"
      />
    </div>

    <!-- Info -->
    <div class="flex flex-col justify-center">
      <span
        class="mb-2 text-sm font-medium
        text-primary-500"
      >
        {fechaDeTrabajo}
      </span>

      <h3
        class="text-xl lg:text-2xl font-bold
        text-gray-900 dark:text-white"
      >
        {titulo}
      </h3>

      <p
        class="mt-1 text-gray-600 dark:text-gray-300
        font-medium"
      >
        {rol}
      </p>
    </div>
  </div>

  <!-- Functions -->
  <ul
    class="relative mt-6 space-y-3
    text-sm md:text-base
    text-gray-600 dark:text-gray-300"
  >
    {
      funciones.map((funcion) => (
        <li class="flex items-start gap-3">
          <span
            class="mt-2 w-2 h-2 rounded-full
            bg-primary-500"
          />

          <span>{funcion}</span>
        </li>
      ))
    }
  </ul>
</article>
