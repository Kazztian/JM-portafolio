---
import { getCollection } from "astro:content";
import BannerSmall from "@components/banners/BannerSmall.astro";
import ButtonCategory from "@components/buttons/ButtonCategory.astro";
import { Image } from "astro:assets";
import { getLangFromUrl } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);

const allProjects = await getCollection("projects");
const allCategories = await getCollection("categoriesProjects");

const currentProjects = allProjects.filter((project) =>
  project.id.startsWith(`${lang}/`),
);

// Get the selected category from URL params if available
const selectedCategory = Astro.url.searchParams.get("category");

const filteredProjects = selectedCategory
  ? currentProjects.filter((project) =>
      project.data.category.some((cat) => cat.id === selectedCategory),
    )
  : currentProjects;
---

<BannerSmall title={lang === "en" ? "My Projects" : "Mis Proyectos"} />

<section class="px-6 py-12 max-w-7xl mx-auto">
  {/* Mobile Category Filter - Custom Dropdown */}
  <div class="lg:hidden mb-8 relative">
    <button
      id="category-dropdown-toggle"
      class="w-full px-4 py-3 rounded-lg border-2 border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white font-semibold cursor-pointer flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
    >
      <span id="category-dropdown-label">
        {
          selectedCategory
            ? allCategories.find((c) => c.data.id === selectedCategory)?.data
                .name ||
              (lang === "en" ? "All Categories" : "Todas las Categorías")
            : lang === "en"
              ? "All Categories"
              : "Todas las Categorías"
        }
      </span>
      <svg
        class="w-5 h-5 transition-transform"
        id="category-dropdown-arrow"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </button>

    {/* Dropdown Menu */}
    <div
      id="category-dropdown-menu"
      class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-gray-800 border-2 border-gray-700 rounded-lg shadow-lg hidden z-40 overflow-hidden"
    >
      <a
        href={`${lang === "en" ? "/en" : ""}/projects`}
        class={`block w-full px-4 py-3 text-left font-semibold transition-colors ${
          !selectedCategory
            ? "bg-gray-700 text-white"
            : "text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700"
        }`}
        data-category="all"
      >
        {lang === "en" ? "All Categories" : "Todas las Categorías"}
      </a>

      {
        allCategories.map((category) => (
          <a
            href={`${lang === "en" ? "/en" : ""}/projects?category=${category.data.id}`}
            class={`block w-full px-4 py-3 text-left font-semibold transition-all ${
              selectedCategory === category.data.id
                ? "text-white"
                : "text-gray-900 dark:text-white"
            }`}
            style={`
            background-color: ${selectedCategory === category.data.id ? category.data.color : "transparent"};
          `}
            data-category={category.data.id}
            onmouseover={`this.style.backgroundColor='${category.data.color}'; this.style.color='white'; this.style.opacity='0.9';`}
            onmouseout={`this.style.backgroundColor='${selectedCategory === category.data.id ? category.data.color : "transparent"}'; this.style.color='${selectedCategory === category.data.id ? "white" : ""}'; this.style.opacity='1';`}
          >
            {category.data.name}
          </a>
        ))
      }
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    {/* Sidebar - Categories (Hidden on Mobile) */}
    <div class="hidden lg:flex flex-col gap-4 relative z-10">
      <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">
        {lang === "en" ? "Categories" : "Categorías"}
      </h3>

      {/* All Projects Button */}
      <a
        href={`${lang === "en" ? "/en" : ""}/projects`}
        class={`inline-flex items-center gap-3 px-6 py-3 rounded-lg font-semibold transition-all duration-300 ${
          !selectedCategory
            ? "scale-105 shadow-lg text-white bg-gray-700"
            : "hover:scale-105 text-gray-700 dark:text-gray-300 hover:text-gray-700 dark:hover:text-gray-300 border-2 border-gray-700"
        }`}
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path>
        </svg>
        <span>{lang === "en" ? "All" : "Todos"}</span>
      </a>

      {/* Category Buttons */}
      {
        allCategories.map((category) => (
          <ButtonCategory
            id={category.data.id}
            title={category.data.name}
            link={`${lang === "en" ? "/en" : ""}/projects?category=${category.data.id}`}
            color={category.data.color}
            isActive={selectedCategory === category.data.id}
          />
        ))
      }
    </div>

    {/* Projects Grid */}
    <div class="lg:col-span-3">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          filteredProjects.length > 0 ? (
            filteredProjects.map((project) => (
              <div
                class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden
                      transition-all duration-300 ease-in-out
                      hover:-translate-y-2 hover:shadow-2xl flex flex-col"
              >
                <a
                  href={`${lang === "en" ? "/en" : ""}/projects/${project.id.split("/")[1]}`}
                  class="block flex-1"
                >
                  <Image
                    src={project.data.cover}
                    alt={project.data.title}
                    class="w-full h-48 object-cover"
                  />

                  <div class="p-4">
                    <h2 class="font-title text-xl font-bold text-gray-900 dark:text-gray-100">
                      {project.data.title}
                    </h2>

                    <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm">
                      {project.data.description}
                    </p>
                  </div>
                </a>

                {/* Category Tags - Outside the link */}
                <div class="px-4 pb-4 pt-2 border-t border-gray-200 dark:border-gray-700 flex flex-wrap gap-2">
                  {project.data.category.map((cat) => {
                    const categoryObj = allCategories.find(
                      (c) => c.data.id === cat.id,
                    );
                    return (
                      <a
                       href={`${lang === "en" ? "/en" : ""}/projects?category=${cat.id}`}
                        class="inline-flex items-center gap-1 px-3 py-1 rounded-lg font-semibold text-sm transition-all hover:scale-105"
                        style={`
                        background-color: transparent;
                        border: 2px solid ${categoryObj?.data.color};
                        color: ${categoryObj?.data.color};
                      `}
                      >
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                          />
                        </svg>
                        {categoryObj?.data.name}
                      </a>
                    );
                  })}
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-2 text-center py-12">
              <p class="text-gray-600 dark:text-gray-400">
                {lang === "en"
                  ? "No projects found"
                  : "No se encontraron proyectos"}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Category Dropdown Toggle
  const dropdownToggle = document.getElementById("category-dropdown-toggle");
  const dropdownMenu = document.getElementById("category-dropdown-menu");
  const dropdownArrow = document.getElementById("category-dropdown-arrow");

  if (dropdownToggle && dropdownMenu) {
    dropdownToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      dropdownMenu.classList.toggle("hidden");
      dropdownArrow.classList.toggle("rotate-180");
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (
        !dropdownToggle.contains(e.target) &&
        !dropdownMenu.contains(e.target)
      ) {
        dropdownMenu.classList.add("hidden");
        dropdownArrow.classList.remove("rotate-180");
      }
    });

    // Close dropdown when an option is clicked
    const dropdownLinks = dropdownMenu.querySelectorAll("a");
    dropdownLinks.forEach((link) => {
      link.addEventListener("click", () => {
        dropdownMenu.classList.add("hidden");
        dropdownArrow.classList.remove("rotate-180");
      });
    });
  }
</script>
