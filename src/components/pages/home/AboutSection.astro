---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { Image } from "astro:assets";

import TechCard from "@components/cards/TechCard.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Tu imagen
import imgMe from "@assets/brand/me.png";

// Logos reales tuyos
import svgPython from "@assets/logos/logoPython.svg";
import svgReact from "@assets/logos/logoReact.svg";
import svgMySQL from "@assets/logos/logoMySql.svg";
import svgSQL from "@assets/logos/logoSQL.svg";
import svgGit from "@assets/logos/logoGit.svg";
import svgGithub from "@assets/logos/logoGithub.svg";
---

<section class="container mx-auto px-4 py-20 lg:py-28">
  <h2
    class="text-center font-title font-bold text-3xl lg:text-5xl mb-14
    text-neutral-900 dark:text-white"
  >
    {t("home.about.title")}
  </h2>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
    <!-- INFORMACIÓN -->
    <div>
      <div
        class="h-full lg:min-h-[550px]
  bg-white dark:bg-neutral-900
  border border-neutral-200 dark:border-neutral-800
  rounded-3xl p-8 shadow-lg"
      >
        <h3
          class="text-center font-title font-bold text-2xl mb-8
  text-neutral-900 dark:text-white"
        >
          {t("home.about.infoTitle")}
        </h3>

        <ul class="flex flex-col gap-6">
          {
            t("home.about.bio").map(
              (item: { title: string; description: string }) => (
                <li>
                  <p
                    class="text-base lg:text-lg
                text-neutral-700 dark:text-neutral-300
                leading-relaxed"
                  >
                    <span class="font-semibold text-primary-600 dark:text-primary-400">
                      {item.title}:
                    </span>{" "}
                    {item.description}
                  </p>
                </li>
              ),
            )
          }
        </ul>
      </div>
    </div>

    <!-- FOTO -->
    <div class="flex justify-center items-center">
      <div
        class="relative rounded-3xl overflow-hidden
      bg-gradient-to-br from-primary-500/20 to-primary-700/20
      p-2 backdrop-blur-lg"
      >
        <div
          class="absolute inset-0 bg-white/10 dark:bg-black/10 backdrop-blur-xl"
        >
        </div>

        <Image
          src={imgMe}
          alt="Juan Sebastian Madrid"
          class="relative z-10
  w-full max-w-[320px]
  object-cover rounded-2xl"
        />
      </div>
    </div>

    <!-- STACK -->
    <div>
      <div
        class="h-full lg:min-h-[550px]
  bg-white dark:bg-neutral-900
  border border-neutral-200 dark:border-neutral-800
  rounded-3xl p-8 shadow-lg"
      >
        <h3
          class="text-center font-title font-bold text-2xl mb-8
         text-neutral-900 dark:text-white"
        >
          {t("home.about.titleStack")}
        </h3>

        <div
          class="grid gap-4
  [grid-template-columns:repeat(auto-fit,minmax(120px,1fr))]"
        >
          <TechCard title="Python" img={svgPython} />
          <TechCard title="React" img={svgReact} />
          <TechCard title="MySQL" img={svgMySQL} />
          <TechCard title="SQL" img={svgSQL} />
          <TechCard title="Git" img={svgGit} />
          <TechCard title="GitHub" img={svgGithub} />
        </div>
      </div>
    </div>
  </div>
</section>
