---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import HabilityCard from "@components/cards/HabilityCard.astro";

import {
  ComputerDesktopIcon,
  ServerIcon,
  CircleStackIcon,
} from "@heroicons/react/24/outline";
---

<section
  class="container py-20 lg:py-28 px-4 lg:px-0"
>
  <!-- TITULO -->
  <div class="text-center mb-16">
    <h2
      class="font-title font-bold text-3xl lg:text-5xl text-neutral-900 dark:text-white"
    >
      {t("home.hability.title")}
    </h2>

    <p
      class="mt-4 text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto text-base lg:text-lg"
    >
      Soluciones enfocadas en desarrollo backend, análisis de datos y
      experiencias web modernas.
    </p>
  </div>

  <!-- CARDS -->
  <div
    class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 lg:gap-10"
  >
    <div
      class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-3xl p-8 hover:-translate-y-2 hover:shadow-2xl transition-all duration-300"
    >
      <HabilityCard
        title={t("home.hability.card1.title")}
        icon={ComputerDesktopIcon}
        description={t("home.hability.card1.description")}
      />
    </div>

    <div
      class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-3xl p-8 hover:-translate-y-2 hover:shadow-2xl transition-all duration-300"
    >
      <HabilityCard
        title={t("home.hability.card2.title")}
        icon={ServerIcon}
        description={t("home.hability.card2.description")}
      />
    </div>

    <div
      class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-3xl p-8 hover:-translate-y-2 hover:shadow-2xl transition-all duration-300"
    >
      <HabilityCard
        title={t("home.hability.card3.title")}
        icon={CircleStackIcon}
        description={t("home.hability.card3.description")}
      />
    </div>
  </div>
</section>