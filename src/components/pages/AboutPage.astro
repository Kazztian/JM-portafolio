---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import CharacterCard from "./about/CharacterCard.astro";
import Stats from "./about/Stats.astro";

import AboutCard from "@components/cards/AboutCard.astro";

import Certifications from "./about/Certifications.astro";
---

<section class="relative container mx-auto px-4 pt-10 pb-20">

  <!-- Glow -->
  <div
    class="absolute top-40 left-1/2 -translate-x-1/2
    w-[600px] h-[600px]
    bg-primary-500/10
    blur-[150px]
    rounded-full
    -z-10"
  />

  <div class="max-w-7xl mx-auto">

    <!-- Hero -->
    <header class="text-center mb-16">

  <h1
    class="text-5xl lg:text-5xl
    font-title font-bold
    text-neutral-900 dark:text-white"
  >
    {t("about.title")}
  </h1>

  <p
    class="mt-6 max-w-3xl mx-auto
    text-lg leading-relaxed
    text-neutral-600 dark:text-neutral-400"
  >
    {t("about.description")}
  </p>

</header>

    <!-- Character + Stats -->
    <div
      class="grid
      lg:grid-cols-[1.8fr_1fr]
      gap-8
      items-start"
    >

      <CharacterCard />

      <Stats />

    </div>

    <!-- Cards -->
    <div
      class="grid
      md:grid-cols-2
      xl:grid-cols-3
      gap-8
      mt-16"
    >

      <AboutCard
        title={t("about.myHistory.title")}
        description={t("about.myHistory.description")}
      />

      <AboutCard
        title={t("about.myExperience.title")}
        description={t("about.myExperience.description")}
      />

      <AboutCard
        title={t("about.myVision.title")}
        description={t("about.myVision.description")}
      />

    </div>

    <!-- Certifications -->
    <div class="mt-24">

      <Certifications />

    </div>

  </div>

</section>