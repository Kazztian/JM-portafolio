---
import { db, Comment, Author, eq } from "astro:db";
import ProjectLayout from "@layouts/ProjectLayout.astro";

const { project, slug } = Astro.props;

/* 🔥 SOLO GET */
const comentarios = await db
  .select()
  .from(Comment)
  .where(eq(Comment.postId, slug));

const authors = await db.select().from(Author);
---

<ProjectLayout project={project}>
  {/* 🔹 CONTENIDO */}
  <div class="mb-20">
    <slot />
  </div>

  {/* 🔹 COMENTARIOS */}
  <div class="max-w-5xl mx-auto px-6">
    <section
      class="max-w-xl mx-auto p-6 bg-white dark:bg-gray-900 rounded-xl shadow-md"
    >
      {/* LISTA */}
      {
        comentarios.map((comentario) => {
          const author = authors.find((a) => a.id === comentario.authorId);

          return (
            <div class="bg-gray-100 dark:bg-gray-800 p-4 rounded mb-3">
              <p class="text-gray-800 dark:text-gray-100">{comentario.body}</p>

              <p class="text-xs mt-2 text-gray-500">
                {author?.name ?? "Anon"} · {author?.country ?? "🌎"}
              </p>
            </div>
          );
        })
      }

      {/* FORM */}
      <h2 class="text-xl font-bold mb-4 text-gray-800 dark:text-gray-100">
        Deja un comentario
      </h2>

      <form method="POST" action="/api/comment" class="space-y-4">
        <div>
          <label class="block text-sm mb-1 text-gray-700 dark:text-gray-200">
            Nombre
          </label>
          <input
            type="text"
            name="name"
            required
            class="w-full border rounded px-3 py-2 dark:bg-gray-800 dark:border-gray-700"
          />
        </div>

        <div>
          <label class="block text-sm mb-1 text-gray-700 dark:text-gray-200">
            País (opcional)
          </label>
          <input
            type="text"
            name="country"
            class="w-full border rounded px-3 py-2 dark:bg-gray-800 dark:border-gray-700"
          />
        </div>

        <input type="hidden" name="slug" value={slug} />

        <input type="hidden" name="currentPath" value={Astro.url.pathname} />

        <div>
          <label class="block text-sm mb-1 text-gray-700 dark:text-gray-200">
            Comentario
          </label>
          <textarea
            name="comment"
            rows="4"
            required
            class="w-full border rounded px-3 py-2 dark:bg-gray-800 dark:border-gray-700"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-blue-700 text-white py-2 rounded hover:bg-blue-600 transition"
        >
          Enviar
        </button>
      </form>
    </section>
  </div>
</ProjectLayout>
