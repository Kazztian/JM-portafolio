---
import ContactForm from "@components/forms/ContactForm";
import { useTranslations } from "@i18n/utils";

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="relative py-16">

  <div class="max-w-6xl mx-auto px-4">

    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl lg:text-5xl font-title font-semibold text-neutral-900 dark:text-neutral-100 mb-4">
        {t("contact.title")}
      </h1>

      <p class="text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
        {t("contact.description")}
      </p>
    </div>

    <!-- Grid -->
    <div class="grid lg:grid-cols-3 gap-8 items-start">

      <!-- INFO CARD -->
<div class="space-y-4">

  <div class="relative group rounded-3xl overflow-hidden
    border border-gray-200 dark:border-blue-500/20
    bg-white/80 dark:bg-blue-950/30
    backdrop-blur-sm
    p-6 lg:p-8
    shadow-lg
    hover:shadow-2xl hover:shadow-primary-500/10
    transition-all duration-300
    h-full
  ">

    <!-- Glow igual al form -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-100
      transition-opacity duration-300
      bg-gradient-to-br from-primary-500/5 via-transparent to-blue-400/10"
    />

    <!-- Content -->
    <div class="relative">

      <h2 class="text-xl font-semibold mb-6 text-neutral-900 dark:text-blue-100">
        {t("contact.info.title")}
      </h2>

      <p class="text-neutral-600 dark:text-blue-200 mb-4">
        📍 {t("contact.info.locationValue")}
      </p>

      <p class="text-neutral-600 dark:text-blue-200 mb-4">
        💼 {t("contact.info.availabilityValue")}
      </p>

      <a
        href="https://wa.me/573202201315"
        target="_blank"
        class="text-primary-500 font-medium hover:text-primary-400 transition-colors"
      >
        📱 {t("contact.info.whatsappValue")}
      </a>

    </div>

  </div>

</div>

      <!-- FORM -->
      <div class="lg:col-span-2 relative group rounded-3xl overflow-hidden
        border border-gray-200 dark:border-gray-700
        bg-white/80 dark:bg-gray-800/80
        backdrop-blur-sm
        p-6 lg:p-8
        shadow-lg
        hover:shadow-2xl hover:shadow-primary-500/10
        transition-all duration-300
        h-full"
      >

        <div class="absolute inset-0 opacity-0 group-hover:opacity-100
          transition-opacity duration-300
          bg-gradient-to-br from-primary-500/5 via-transparent to-primary-400/10"
        />

        <div class="relative">
          <h2 class="text-xl font-semibold mb-6 text-neutral-900 dark:text-neutral-100">
            {t("contact.form.submit")}
          </h2>

          <ContactForm lang={lang} client:load />
        </div>

      </div>

    </div>
  </div>

</section>