---
interface Props {
  id: string;
  title: string;
  link: string;
  color: string;
  isActive?: boolean;
}

const { id, title, link, color, isActive = false } = Astro.props;

// Map category IDs to Heroicons
const iconMap: Record<string, string> = {
  backend: "server",
  web: "computer-desktop",
  mobile: "device-phone-mobile",
  games: "sparkles",
  ui: "palette",
};

const getIcon = (categoryId: string) => {
  return iconMap[categoryId] || "folder";
};

const iconSvg = getIcon(id);
---

<a
  href={link}
  class={`inline-flex items-center gap-3 px-6 py-3 rounded-lg font-semibold transition-all duration-300 ${
    isActive
      ? "scale-105 shadow-lg text-white"
      : "hover:scale-105 text-gray-700 dark:text-gray-300 hover:text-white"
  }`}
  style={`background-color: ${isActive ? color : "transparent"}; border: 2px solid ${color};`}
>
  {iconSvg === "server" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 12h14M5 12a2 2 0 01-2-2V5a2 2 0 012-2h14a2 2 0 012 2v5a2 2 0 01-2 2M5 12a2 2 0 00-2 2v5a2 2 0 002 2h14a2 2 0 002-2v-5a2 2 0 00-2-2m-2-4H7a2 2 0 00-2 2v4a2 2 0 002 2h10a2 2 0 002-2V8a2 2 0 00-2-2z"
      ></path>
    </svg>
  )}
  {iconSvg === "computer-desktop" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9.75 17L9 20m0 0l-.75 3M9 20H5a1 1 0 01-1-1v-1a6 6 0 0112 0v1a1 1 0 01-1 1m0 0l.75 3M9 20h10m0 0l.75 3m-.75-3l.75-3m0 0h4a1 1 0 001-1v-1a6 6 0 00-12 0v1a1 1 0 001 1h4l-.75 3M15 7a3 3 0 11-6 0 3 3 0 016 0z"
      ></path>
    </svg>
  )}
  {iconSvg === "device-phone-mobile" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
      ></path>
    </svg>
  )}
  {iconSvg === "sparkles" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
      ></path>
    </svg>
  )}
  {iconSvg === "palette" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
      ></path>
    </svg>
  )}
  {iconSvg === "folder" && (
    <svg
      class="w-5 h-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
      ></path>
    </svg>
  )}
  <span>{title}</span>
</a>
