---
interface Props {
  text: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  onClick?: () => void;
}

const {
  text,
  type = "button",
  variant = "primary",
  size = "md",
  href,
  onClick,
} = Astro.props;

const baseClass = `
  inline-flex items-center justify-center
  rounded-xl
  font-semibold font-text
  transition-all duration-300
  transform hover:scale-105
  hover:shadow-xl
  active:scale-95
  backdrop-blur-md
`;

const variantClass = {
  primary: `
    bg-primary-600 hover:bg-primary-700
    dark:bg-primary-600 dark:hover:bg-primary-500
    text-white
    shadow-lg shadow-primary-500/20
  `,

  ghost: `
    bg-white/70 dark:bg-neutral-800/70
    hover:bg-neutral-100 dark:hover:bg-neutral-700
    border border-neutral-300 dark:border-neutral-700
    text-neutral-900 dark:text-neutral-100
  `,
}[variant];

const sizeClass = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-3 text-base",
  lg: "px-7 py-4 text-lg",
}[size];
---

<astro-button>
  {
    href ? (
      <a
        href={href}
        class={`${baseClass} ${variantClass} ${sizeClass}`}
      >
        {text}
      </a>
    ) : (
      <button
        type={type}
        class={`${baseClass} ${variantClass} ${sizeClass}`}
        data-click={onClick}
      >
        {text}
      </button>
    )
  }
</astro-button>

<script>
  class AstroButton extends HTMLElement {
    constructor() {
      super();

      const onclick = this.dataset.click;

      if (onclick) {
        const func = new Function(onclick);

        this.addEventListener("click", () => {
          func();
        });
      }
    }
  }

  customElements.define("astro-button", AstroButton);
</script>

