---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    href: string;
    icon: ImageMetadata;
}

const { href, icon } = Astro.props as Props;
---
<a 
  href={href} 
  class="inline-flex items-center justify-center bg-neutral-200 p-2.5 rounded-full hover:bg-neutral-300 transition"
  target="_blank" 
  rel="noopener noreferrer"
>
  <Image 
    src={icon} 
    alt="Icono social" 
    class="w-6 h-6"
  />
</a>